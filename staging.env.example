# Copy to .env.staging.local; never commit that private file.
# Use a separate Supabase project, migrated through 00014.
# The runner rejects the project normally configured in .env.local.
NUDGE_STAGING_PROJECT_REF=yourstagingref
NEXT_PUBLIC_SUPABASE_URL=https://yourstagingref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3117
NUDGE_E2E_BASE_URL=http://127.0.0.1:3117
# Dedicated non-production accounts with current terms.
# Comparison account has onboarding complete. Dashboard and foundation accounts
# must be separate fresh accounts with no decisions/preferences/answers.
NUDGE_E2E_EMAIL=
NUDGE_E2E_PASSWORD=
NUDGE_DASHBOARD_TEST_EMAIL=
NUDGE_DASHBOARD_TEST_PASSWORD=
NUDGE_FOUNDATION_TEST_EMAIL=
NUDGE_FOUNDATION_TEST_PASSWORD=
# Optional: use an installed Chrome binary; otherwise install Playwright Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# This command disables AI/enrichment/admin keys and account deletion.
# Do not add production secrets or real journal data to this file.
