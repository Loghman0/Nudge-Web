{
  "name": "nudge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:check": "node scripts/check-development.mjs",
    "test:ai:contracts": "node scripts/evaluate-ai-contracts.mjs",
    "ai:configure:nvidia:dev": "node scripts/configure-nvidia-development.mjs",
    "test:ai:nvidia:live": "node scripts/verify-nvidia-disposable.mjs",
    "types": "node scripts/generate-types.mjs",
    "test": "node --import ./tests/register.mjs --test --test-concurrency=4 --test-reporter=spec tests/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "dev:webpack": "next dev --webpack",
    "release:check": "node scripts/check-release.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public": "node scripts/run-e2e.mjs public",
    "test:e2e:auth": "node scripts/run-e2e.mjs auth",
    "test:e2e:staging": "node scripts/run-e2e.mjs staging",
    "test:hosted": "node scripts/verify-hosted-disposable.mjs",
    "sql:release": "node scripts/build-release-sql.mjs",
    "sql:check": "node scripts/build-discover-expansion.mjs --check && node scripts/discovery-build-catalog.mjs --check && node scripts/discovery-build-seed.mjs --check && node scripts/build-release-sql.mjs --check && node scripts/build-setup.mjs --check",
    "release:package": "node scripts/package-release.mjs",
    "release:archive-check": "node scripts/check-archive.mjs",
    "release:verify": "npm run release:check && npm run verify && npm run sql:check && npm run test:e2e:public && npm run test:e2e:auth && npm run release:package && npm run release:archive-check"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.49.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "motion": "14.2.0",
    "next": "16.4.3",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.2",
    "lighthouse": "13.5.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
