NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set false for a Google-only signup demo until custom SMTP is configured.
# Existing email-account login and password recovery remain available. Rebuild after changing.
NEXT_PUBLIC_EMAIL_SIGNUP_ENABLED=true
# Optional AI. Never use NEXT_PUBLIC_ for a private provider key.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Required for optional AI calls after migration00010. Server only. USD decimal strings.
# See AI-ACCOUNTING.md; use verified rates/ceilings, never copy guessed prices.
NUDGE_AI_USER_DAILY_USD=
NUDGE_AI_GLOBAL_DAILY_USD=
NUDGE_AI_MODEL_PRICES_JSON=

# Optional operator-only question generation CLI. Separate from personal AI budgets.
# Retain .local/catalog-ai-ledger.sqlite and its WAL on one machine; do not copy/reset it to bypass limits.
NUDGE_CATALOG_AI_ENABLED=false
NUDGE_CATALOG_AI_MODEL=lightning
NUDGE_CATALOG_AI_DAILY_USD=
NUDGE_CATALOG_AI_DAILY_REQUESTS=
NUDGE_CATALOG_AI_MINUTE_REQUESTS=
ANTHROPIC_API_KEY=
# NVIDIA: set AI_PROVIDER=nvidia. Use rotated keys in server deployment settings.
# A shared key works for all models; per-model keys override it.
NVIDIA_API_KEY=
NVIDIA_SUPER_API_KEY=
NVIDIA_ULTRA_API_KEY=
NVIDIA_GPT_OSS_API_KEY=
NVIDIA_GEMMA_API_KEY=
# Current free prototype defaults; old super/ultra routes require explicit opt-in.
NVIDIA_LIGHTNING_API_KEY=
NVIDIA_ENABLED_MODELS=lightning,gemma
# Slot names or exact catalog model IDs. Only enabled models may be selected.
NVIDIA_EXTRACTION_MODEL=gemma
NVIDIA_REASONING_MODEL=gemma
NVIDIA_PARSING_MODEL=lightning
NVIDIA_SUMMARY_MODEL=gemma
# Set by npm run ai:configure:nvidia:dev after adding your key.
# Prototype free access is blocked in public launch mode.
NUDGE_AI_DEVELOPMENT_FREE=false
# Optional enrichment.
TMDB_API_KEY=
GOOGLE_PLACES_API_KEY=
# Public browser push key; private keys belong in Supabase Edge secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Public launch: fill real operator/provider details, then set this true.
NUDGE_PUBLIC_LAUNCH=false
# Discovery release gates. Enable only after reviewing written-answer safety,
# localized support, and the optional-topic bank. User opt-in is also required.
# The current English phrase check is not a validated multilingual classifier.
NUDGE_DISCOVERY_WRITTEN_READY=false
NUDGE_DISCOVERY_OPTIONAL_READY=false
NUDGE_OPERATOR_NAME=
NUDGE_OPERATOR_COUNTRY=
NUDGE_OPERATOR_ADDRESS=
NUDGE_CONTACT_EMAIL=
NUDGE_HOSTING_PROVIDER=
NUDGE_DATA_REGION=
NUDGE_TRANSFER_SAFEGUARDS=
NUDGE_BACKUP_RETENTION_DAYS=
NUDGE_LOG_RETENTION_DAYS=
# Required if an AI provider is configured for public use.
NUDGE_AI_VENDOR=
NUDGE_AI_PRIVACY_URL=
# Server-only: enables verified self-service account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Android Firebase HTTP v1 sender. Never use EXPO_PUBLIC_ for these.
# Use a project-scoped Firebase Cloud Messaging sender, not an owner credential.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Random secret of at least 32 characters for POST /api/cron/native-checkins.
# Store the same value in the approved scheduler's private secret store.
CHECKINS_CRON_SECRET=
